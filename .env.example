# Local Python defaults use SQLite and filesystem objects; no credentials needed.
DEMO_MODE=true
DATA_DIR=.data
# For a private hosted workspace, set DEMO_MODE=false and strong random secrets.
# API_TOKEN=
# SIGNING_KEY=
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/doculens
# STORAGE_BACKEND=s3
# S3_BUCKET=your-private-bucket
# AWS_DEFAULT_REGION=us-east-1
# CORS_ORIGINS=https://your-frontend.example
# VITE_API_BASE_URL=https://your-api.example
# Environment is read from the process; use your launcher or deployment secret store.
